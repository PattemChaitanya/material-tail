{
  "compilerOptions": {
    "target": "es2020",
    "module": "Node16",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "scripts"]
}
